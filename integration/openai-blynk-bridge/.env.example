# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna

# Blynk
# Use your regional Blynk server if shown in the Blynk Console, e.g. https://fra1.blynk.cloud
BLYNK_SERVER=https://blynk.cloud
BLYNK_DEVICE_TOKEN=YOUR_BLYNK_DEVICE_TOKEN

# Webhook protection
# Use a long random alphanumeric value and configure the same value in the Blynk webhook header.
WEBHOOK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

PORT=3000
