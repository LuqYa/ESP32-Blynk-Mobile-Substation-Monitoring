# Required Blynk connection
BLYNK_SERVER=https://blynk.cloud
BLYNK_DEVICE_TOKEN=YOUR_BLYNK_DEVICE_TOKEN

# Required webhook protection
WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional OpenAI advisory upgrade
# The bridge still works without these and uses a rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

PORT=3000
